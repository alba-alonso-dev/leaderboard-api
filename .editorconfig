root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,slnx,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# var usage
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression-bodied members & modern syntax
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Naming: private fields _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Constants PascalCase (overrides the rule above for private const)
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.constants_pascal.priority = 1

# private static readonly PascalCase (e.g. cached instances)
dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_pascal.priority = 1
dotnet_naming_rule.private_fields_underscore.priority = 2

# Analyzer tuning
# CA1848/CA1873: LoggerMessage delegates are used on hot paths; templates elsewhere are fine.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# CA2007: no SynchronizationContext in ASP.NET Core.
dotnet_diagnostic.CA2007.severity = none
# CA1062: nullable reference types already cover argument null checks.
dotnet_diagnostic.CA1062.severity = none
# CA1515: public types are needed across assemblies (endpoints, DTOs used by tests).
dotnet_diagnostic.CA1515.severity = none
# CA1716: 'Error' is an intentional domain name.
dotnet_diagnostic.CA1716.severity = none
# CA1819: byte[] properties are persistence-mapped values.
dotnet_diagnostic.CA1819.severity = none
# CA1054/CA1056: URIs as strings are fine in DTOs.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none
# CA1000: static factories on generic Result<T> are the intended API.
dotnet_diagnostic.CA1000.severity = none
# CA1031: the global exception handler intentionally catches everything.
dotnet_diagnostic.CA1031.severity = suggestion
# CA1812: internal classes instantiated via DI.
dotnet_diagnostic.CA1812.severity = none
# IDE0005 needs GenerateDocumentationFile (enabled) to run on build.
dotnet_diagnostic.IDE0005.severity = warning

# EF Core migrations are generated code.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
