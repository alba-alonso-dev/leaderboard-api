{
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "leaderboard-api",
    "Audience": "leaderboard-api-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenLifetimeDays": 7
  },
  "ApiKeys": {
    "SignatureWindowSeconds": 300
  },
  "Scores": {
    "MaxPerPlayerPerMinute": 10
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPerMinute": 5,
    "ScoreSubmitPerMinute": 60,
    "ScoreSubmitBurst": 20,
    "PublicReadPerMinute": 120
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Serilog": {
    "Format": "json",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
