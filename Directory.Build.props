<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: XML docs only where they add value. CA1848: LoggerMessage is used on hot paths only. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Test naming (Method_Scenario_Result) and fixtures intentionally break some production rules. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1861;CA1001;CA1063;CA1816;CA2234</NoWarn>
  </PropertyGroup>
</Project>
