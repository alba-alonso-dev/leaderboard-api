# Copy to .env to override the development defaults used by compose.yaml.
# Never commit a real .env file.
POSTGRES_PASSWORD=leaderboard-dev-password
POSTGRES_PORT=5432
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=compose-dev-only-signing-key-0123456789abcdef
ADMIN_EMAIL=admin@leaderboard.local
ADMIN_PASSWORD=Admin-dev-Passw0rd
